#!/usr/bin/env python3
import argparse
import glob
import os
import select
import shutil
import socket
import struct
import subprocess
import sys
import tempfile
import time

COMMAND_PING = 1
COMMAND_WRITE = 2
COMMAND_READ = 3
COMMAND_RUN = 4
COMMAND_KILL = 5
COMMAND_LIST = 6
COMMAND_DELETE = 7
COMMAND_MAKE_DIRECTORY = 8
COMMAND_REMOVE_DIRECTORY = 9
COMMAND_MOVE = 10
COMMAND_QUIT = 11
COMMAND_HANDOVER = 12
COMMAND_SCREENSHOT = 0x40
REPLY_FLAG = 0x8000
REPLY_HEADER_SIZE = 8
WRITE_CREATE = 0x1
CLIENT_SEQUENCES = 0x7FFF
FILE_ATTRIBUTE_DIRECTORY = 0x10
AGENT_ERRORS = {
    0x20000001: "unknown command",
    0x20000002: "malformed request",
    0x20000003: "no such process",
    0x20000005: "still running 5 seconds after being told to end",
}
WINDOWS_ERRORS = {2: "file not found", 3: "path not found", 5: "access denied", 80: "file exists", 112: "disk full", 183: "already exists"}


class AgentError(Exception):
    pass


def command_line(arguments):
    return " ".join('"%s"' % argument if (" " in argument or "\t" in argument) and '"' not in argument else argument for argument in arguments)


def ce_path(path):
    path = path.replace("/", "\\")
    return path if path.startswith("\\") else "\\" + path


def encode_string(text):
    encoded = text.encode("utf-16-le")
    return struct.pack("<H", len(encoded) // 2) + encoded


def decode_string(data, position):
    count = struct.unpack_from("<H", data, position)[0]
    start = position + 2
    return data[start:start + count * 2].decode("utf-16-le"), start + count * 2


DEFAULT_PORT = 2100
SCREENSHOT_PATH = "\\debugmgr-screenshot.bmp"
USB_DEVICE = (0x04DD, 0x9244)
RNDIS_DEVICE = (0x045E, 0x0302)
RNDIS_ADDRESS = "127.0.0.1:%d" % DEFAULT_PORT
BULK_IN = 0x81
BULK_OUT = 0x02
SET_CONTROL_LINE_STATE = 0x22
DTR_AND_RTS = 3


def device_address(text):
    host, _, port = text.rpartition(":") if ":" in text else (text, "", "")
    return host, int(port) if port else DEFAULT_PORT


class SerialConnection:
    def __init__(self, path, timeout):
        import termios
        import tty
        self.descriptor = os.open(path, os.O_RDWR | os.O_NOCTTY)
        tty.setraw(self.descriptor)
        attributes = termios.tcgetattr(self.descriptor)
        attributes[2] |= termios.CLOCAL | termios.CREAD
        termios.tcsetattr(self.descriptor, termios.TCSANOW, attributes)
        termios.tcflush(self.descriptor, termios.TCIOFLUSH)
        self.timeout = timeout

    def settimeout(self, timeout):
        self.timeout = timeout

    def sendall(self, data):
        view = memoryview(data)
        while view:
            view = view[os.write(self.descriptor, view):]

    def recv(self, length):
        ready, _, _ = select.select([self.descriptor], [], [], self.timeout)
        if not ready:
            raise AgentError("no reply from debugmgr")
        return os.read(self.descriptor, length)


def find_usb_device(vendor, product):
    try:
        import usb.backend.libusb1
        import usb.core
    except ImportError:
        return None
    libraries = sorted(glob.glob("/opt/homebrew/lib/libusb-1.0*.dylib") + glob.glob("/usr/local/lib/libusb-1.0*.dylib"))
    backend = usb.backend.libusb1.get_backend(find_library=lambda name: libraries[0] if libraries else None)
    return usb.core.find(idVendor=vendor, idProduct=product, backend=backend)


class UsbConnection:
    def __init__(self, vendor, product, timeout):
        try:
            import usb.core
            import usb.util
        except ImportError:
            raise AgentError("--usb needs pyusb and libusb")
        self.usb = usb
        self.device = find_usb_device(vendor, product)
        if self.device is None:
            raise AgentError("no USB serial device %04x:%04x" % (vendor, product))
        usb.util.claim_interface(self.device, 0)
        self.device.ctrl_transfer(0x21, SET_CONTROL_LINE_STATE, DTR_AND_RTS, 0, None, timeout=1000)
        self.pending = b""
        self.timeout = timeout

    def settimeout(self, timeout):
        self.timeout = timeout

    def sendall(self, data):
        self.device.write(BULK_OUT, bytes(data), timeout=int((self.timeout or 10) * 1000))

    def recv(self, length):
        if not self.pending:
            try:
                self.pending = bytes(self.device.read(BULK_IN, 65536, timeout=int((self.timeout or 10) * 1000)))
            except self.usb.core.USBTimeoutError:
                raise AgentError("no reply from debugmgr")
        data, self.pending = self.pending[:length], self.pending[length:]
        return data


def usb_id(text):
    vendor, _, product = text.partition(":")
    return int(vendor, 16), int(product, 16)


def serial_ports():
    return sorted(glob.glob("/dev/cu.usbmodem*") + glob.glob("/dev/ttyACM*"))


def connect(arguments):
    if arguments.socket:
        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        connection.settimeout(arguments.timeout)
        connection.connect(arguments.socket)
        return connection
    if arguments.device:
        connection = socket.create_connection(device_address(arguments.device), timeout=arguments.timeout)
        connection.settimeout(arguments.timeout)
        return connection
    if arguments.serial:
        return SerialConnection(arguments.serial, arguments.timeout)
    if arguments.usb:
        return UsbConnection(*usb_id(arguments.usb), arguments.timeout)
    deadline = time.monotonic() + arguments.wait
    while True:
        ports = serial_ports()
        if len(ports) == 1:
            return SerialConnection(ports[0], arguments.timeout)
        if find_usb_device(*USB_DEVICE) is not None:
            return UsbConnection(*USB_DEVICE, arguments.timeout)
        if find_usb_device(*RNDIS_DEVICE) is not None:
            connection = socket.create_connection(device_address(RNDIS_ADDRESS), timeout=arguments.timeout)
            connection.settimeout(arguments.timeout)
            return connection
        if time.monotonic() >= deadline:
            if len(ports) > 1:
                raise AgentError("more than one serial port, pass --serial: %s" % ", ".join(ports))
            raise AgentError("no device: pass --device, --socket, --serial or --usb, or set CE_DEBUG_DEVICE or CE_DEBUG_SOCKET")
        time.sleep(1)


def save_screenshot(agent, local, remote):
    if local.lower().endswith(".bmp"):
        return agent.screenshot(local, remote)
    if not shutil.which("sips"):
        raise AgentError("saving anything but a .bmp needs sips (macOS)")
    with tempfile.TemporaryDirectory() as directory:
        bitmap = os.path.join(directory, "screenshot.bmp")
        width, height, _ = agent.screenshot(bitmap, remote)
        subprocess.run(["sips", "-s", "format", "png", bitmap, "--out", local], check=True, stdout=subprocess.DEVNULL)
    return width, height, os.path.getsize(local)


class Agent:
    def __init__(self, connection):
        self.connection = connection
        self.sequence = 0
        self.capacity = 256
        _, self.capacity, self.version = self.ping()

    def receive_exactly(self, length):
        data = bytearray()
        while len(data) < length:
            chunk = self.connection.recv(length - len(data))
            if not chunk:
                raise AgentError("the connection closed")
            data += chunk
        return bytes(data)

    def request(self, command, payload=b""):
        self.sequence = self.sequence % CLIENT_SEQUENCES + 1
        message = struct.pack("<HH", command, self.sequence) + payload
        if len(message) > self.capacity:
            raise AgentError("request of %d bytes is bigger than debugmgr's %d" % (len(message), self.capacity))
        self.connection.sendall(struct.pack("<I", len(message)) + message)
        while True:
            length = struct.unpack("<I", self.receive_exactly(4))[0]
            reply = self.receive_exactly(length)
            kind, sequence, status = struct.unpack_from("<HHI", reply)
            if kind == command | REPLY_FLAG and sequence == self.sequence:
                break
        if status:
            raise AgentError(AGENT_ERRORS.get(status) or WINDOWS_ERRORS.get(status) or "Windows error %d" % status)
        return reply[REPLY_HEADER_SIZE:]

    def ping(self):
        return struct.unpack("<III", self.request(COMMAND_PING)[:12])

    def put(self, local, remote):
        data = open(local, "rb").read()
        path = encode_string(ce_path(remote))
        chunk = self.capacity - 12 - len(path)
        offset = 0
        while True:
            flags = WRITE_CREATE if offset == 0 else 0
            self.request(COMMAND_WRITE, struct.pack("<II", offset, flags) + path + data[offset:offset + chunk])
            offset += chunk
            if offset >= len(data):
                return len(data)

    def get(self, remote, local):
        path = encode_string(ce_path(remote))
        chunk = self.capacity - REPLY_HEADER_SIZE - 4
        data = bytearray()
        while True:
            reply = self.request(COMMAND_READ, struct.pack("<II", len(data), chunk) + path)
            size = struct.unpack_from("<I", reply)[0]
            data += reply[4:]
            if len(data) >= size or len(reply) == 4:
                break
        open(local, "wb").write(data)
        return len(data)

    def run(self, program, arguments, command=COMMAND_RUN):
        reply = self.request(command, encode_string(ce_path(program) if program else "") + encode_string(arguments))
        return struct.unpack_from("<I", reply)[0]

    def handover(self, program, arguments=""):
        return self.run(program, arguments, COMMAND_HANDOVER)

    def kill(self, process):
        self.request(COMMAND_KILL, struct.pack("<I", process))

    def list(self, folder):
        path = ce_path(folder)
        pattern = path if "*" in path or "?" in path else path.rstrip("\\") + "\\*"
        reply = self.request(COMMAND_LIST, encode_string(pattern))
        count = struct.unpack_from("<I", reply)[0]
        position = 4
        entries = []
        for _ in range(count):
            attributes, size = struct.unpack_from("<II", reply, position)
            name, position = decode_string(reply, position + 8)
            entries.append((name, attributes, size))
        return entries

    def path_command(self, command, *paths):
        self.request(command, b"".join(encode_string(ce_path(path)) for path in paths))

    def screenshot(self, local, remote=SCREENSHOT_PATH):
        width, height = struct.unpack_from("<II", self.request(COMMAND_SCREENSHOT, encode_string(ce_path(remote))))
        try:
            size = self.get(remote, local)
        finally:
            self.path_command(COMMAND_DELETE, remote)
        return width, height, size


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Talk to debugmgr.exe on a Windows CE device over TCP, serial or USB, or in an emulator through its agent socket")
    parser.add_argument("--device", default=os.environ.get("CE_DEBUG_DEVICE"),
                        help="the device's address, host[:port] (port %d if not given), default $CE_DEBUG_DEVICE" % DEFAULT_PORT)
    parser.add_argument("--socket", default=os.environ.get("CE_DEBUG_SOCKET"),
                        help="an emulator's --agent socket, for debugmgr on its host mailbox, default $CE_DEBUG_SOCKET")
    parser.add_argument("--serial", default=os.environ.get("CE_DEBUG_SERIAL"), help="a serial port, default $CE_DEBUG_SERIAL")
    parser.add_argument("--usb", nargs="?", const="%04x:%04x" % USB_DEVICE, default=None,
                        help="a USB serial device through libusb, VID:PID (default %04x:%04x, a Sharp Brain)" % USB_DEVICE)
    parser.add_argument("--wait", type=float, default=0, help="seconds to wait for a device to appear when none is given")
    parser.add_argument("--timeout", type=float, default=30, help="seconds to wait for each reply")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("ping", help="check debugmgr is running")
    command = commands.add_parser("put", help="copy a file to the device")
    command.add_argument("local")
    command.add_argument("remote")
    command = commands.add_parser("get", help="copy a file from the device")
    command.add_argument("remote")
    command.add_argument("local")
    command = commands.add_parser("run", help="start a program and print its process ID")
    command.add_argument("program")
    command.add_argument("arguments", nargs=argparse.REMAINDER)
    command = commands.add_parser("kill", help="end a program started with run")
    command.add_argument("process", type=lambda text: int(text, 0))
    command = commands.add_parser("ls", help="list a folder, or the files matching a pattern such as /Windows/*.exe")
    command.add_argument("folder", nargs="?", default="\\")
    for name, help_text in (("rm", "delete a file"), ("mkdir", "create a folder"), ("rmdir", "remove a folder")):
        command = commands.add_parser(name, help=help_text)
        command.add_argument("path")
    command = commands.add_parser("mv", help="move or rename")
    command.add_argument("source")
    command.add_argument("destination")
    commands.add_parser("quit", help="stop debugmgr")
    command = commands.add_parser("handover", help="start another debugmgr, then stop this one")
    command.add_argument("program", help="program to start, or \"\" to restart this debugmgr")
    command.add_argument("arguments", nargs=argparse.REMAINDER)
    command = commands.add_parser("screenshot", help="save the device's screen as a .bmp on this computer")
    command.add_argument("local")
    command.add_argument("--remote", default=SCREENSHOT_PATH, help="where the device writes it first, default %(default)s")
    arguments = parser.parse_args()
    try:
        agent = Agent(connect(arguments))
        if arguments.command == "ping":
            print("debugmgr protocol %d, CE %d.%02d, %d byte messages" % (agent.ping()[0], agent.version // 100, agent.version % 100, agent.capacity))
        elif arguments.command == "put":
            print("%d bytes" % agent.put(arguments.local, arguments.remote))
        elif arguments.command == "get":
            print("%d bytes" % agent.get(arguments.remote, arguments.local))
        elif arguments.command == "run":
            print("0x%08x" % agent.run(arguments.program, command_line(arguments.arguments)))
        elif arguments.command == "kill":
            agent.kill(arguments.process)
        elif arguments.command == "ls":
            for name, attributes, size in agent.list(arguments.folder):
                print("%s%s" % (name, "\\" if attributes & FILE_ATTRIBUTE_DIRECTORY else "  %d" % size))
        elif arguments.command == "rm":
            agent.path_command(COMMAND_DELETE, arguments.path)
        elif arguments.command == "mkdir":
            agent.path_command(COMMAND_MAKE_DIRECTORY, arguments.path)
        elif arguments.command == "rmdir":
            agent.path_command(COMMAND_REMOVE_DIRECTORY, arguments.path)
        elif arguments.command == "mv":
            agent.path_command(COMMAND_MOVE, arguments.source, arguments.destination)
        elif arguments.command == "quit":
            agent.request(COMMAND_QUIT)
        elif arguments.command == "handover":
            print("0x%08x" % agent.handover(arguments.program, command_line(arguments.arguments)))
        elif arguments.command == "screenshot":
            print("%dx%d, %d bytes" % save_screenshot(agent, arguments.local, arguments.remote))
    except (OSError, AgentError) as error:
        sys.exit("ce-debug: %s" % error)
